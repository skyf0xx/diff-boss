{
  "name": "diff-boss",
  "displayName": "diff-boss",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:host": "esbuild src/extension/activate.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --outfile=dist/extension.js",
    "build:webview": "vite build",
    "build": "pnpm build:host && pnpm build:webview",
    "build:integration": "esbuild \"src/extension/test/**/*.test.ts\" --bundle --platform=node --format=cjs --external:vscode --outdir=out/test",
    "test:integration": "pnpm build && pnpm build:integration && vscode-test",
    "package": "pnpm build && vsce package --no-dependencies --out diff-boss.vsix",
    "smoke:live": "node scripts/smoke-live.mjs"
  }
}
